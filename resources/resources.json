                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
                ["Ctrl", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Enter"],
                ["ShiftLock", "Z", "X", "C", "V", "B", "N", "M", "<", ">", "\""],
                ["?#&", "_", "?", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "ctrl",
              "columns": 12,
              "layout": [
                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "^q", "^w", "^e", "^r", "^t", "^y", "^u", "^i", "^o", "^p"],
                ["Ctrl*", "^a", "^s", "^d", "^f", "^g", "^h", "^j", "^k", "^l", "Enter"],
                ["Shift", "^z", "^x", "^c", "^v", "^b", "^n", "^m", ",", ".", "'"],
                ["?#&", "-", "/", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "sym",
              "columns": 12,
              "layout": [
                ["Esc", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "BS"],
                ["Tab", "~", "`", "|", "\\", "{", "}", "[", "]", "<", ">"],
                ["Ctrl", ";", ":", "\"", "=", "+", "_", "?", "Enter3.5"],
                ["Shift", "Home", "End", "PgUp", "PgDn", "Ins", "Del"],
                ["?#&*", "-", "/", "Space", "Left", "Up", "Down", "Right"]
              ]
            }
          ]
        },
        "pair_address": {
          "height": 360,
          "max_height": 0.33,
          "layers": [
            {
              "id": "main",
              "columns": 5,
              "layout": [
                [1, "1", "2", "3"],
                [1, "4", "5", "6", "BS"],
                ["Left", "7", "8", "9", "Right"],
                ["Close", ":", "0", ".", "OK"]
              ]
            }
          ]
        },
        "pair_code": {
          "height": 360,
          "max_height": 0.33,
          "layers": [
            {
              "id": "main",
              "columns": 5,
              "layout": [
                [1, "1", "2", "3"],
                [1, "4", "5", "6", "BS"],
                ["Left", "7", "8", "9", "Right"],
                ["Close", 1, "0", 1, "OK"]
              ]
            }
          ]
        }
      }
