          "android_badge": "#e8f5e9",
          "destructive_tonal": "#fdecea",
          "log_debug": "#1565c0",
          "log_info": "#2e7d32",
          "log_warning": "#d84315",
          "log_error": "#c62828",
          "log_warning_tonal": "#fff3e0",
          "log_error_tonal": "#fdecea",
          "log_debug_tonal": "#e3f2fd",
          "log_info_tonal": "#e8f5e9",
          "log_message": "#f5f6f7",
          "player_track": "#d0d0d0"
        },
        "dark": {
          "card_title": "#cfd8dc",
          "card_icon": "#90a4ae",
          "online": "#66bb6a",
          "chart_background": "#22262b",
          "chart_memory": "#66bb6a",
          "android": "#66bb6a",
          "android_badge": "#1f3324",
          "destructive_tonal": "#3a1f1f",
          "log_debug": "#64b5f6",
          "log_info": "#81c784",
          "log_warning": "#ff8a65",
          "log_error": "#ef5350",
          "log_warning_tonal": "#3a2a1a",
          "log_error_tonal": "#3a1f1f",
          "log_debug_tonal": "#1a2a3a",
          "log_info_tonal": "#1f3324",
          "log_message": "#22262b",
          "player_track": "#3a3f45"
        }
      },
      "fonts": {
        "caption": "caption_20",
        "body": "body_24",
        "key_symbols": "key_symbols_24"
      },
      "keyboards": {
        "keys": {
          "Esc": { "label": "Esc", "insert": "\u001b", "role": "KeyRole.Special" },
          "Tab": { "label": "Tab", "insert": "\t", "width": 2, "role": "KeyRole.Special" },
          "Ctrl": { "label": "Ctrl", "action": "layer.ctrl", "once": true, "width": 1.5, "role": "KeyRole.Special" },
          "Ctrl*": { "extends": "Ctrl", "action": "layer.base", "once": false, "role": "KeyRole.Primary" },
          "Shift": { "icon": "shift", "action": "layer.shift", "once": true, "double": "caps", "width": 2, "role": "KeyRole.Special" },
          "Shift*": { "extends": "Shift", "action": "layer.base", "once": false, "role": "KeyRole.Primary" },
          "ShiftLock": { "icon": "shift", "action": "layer.base", "width": 2, "role": "KeyRole.Primary" },
          "?#&": { "label": "?#&", "action": "layer.sym", "width": 1.5, "role": "KeyRole.Special" },
          "?#&*": { "extends": "?#&", "action": "layer.base", "role": "KeyRole.Primary" },
          "BS": { "icon": "backspace", "action": "TextInput.Backspace", "role": "KeyRole.Special", "repeat": true },
          "Enter": { "icon": "enter", "action": "TextInput.Enter", "width": 1.5, "role": "KeyRole.Special" },
          "Enter3.5": { "extends": "Enter", "width": 3.5 },
          "Space": { "insert": " ", "width": 4.5, "repeat": true },
          "Left": { "label": "←", "font": "font.key_symbols", "action": "TextInput.Left", "repeat": true },
          "Up": { "label": "↑", "font": "font.key_symbols", "action": "TextInput.Up", "repeat": true },
          "Down": { "label": "↓", "font": "font.key_symbols", "action": "TextInput.Down", "repeat": true },
          "Right": { "label": "→", "font": "font.key_symbols", "action": "TextInput.Right", "repeat": true },
          "Home": { "label": "Home", "action": "TextInput.Home", "width": 1.5, "role": "KeyRole.Special" },
          "End": { "label": "End", "action": "TextInput.End", "width": 1.5, "role": "KeyRole.Special" },
          "PgUp": { "label": "PgUp", "custom": 1, "width": 1.5, "role": "KeyRole.Special", "repeat": true },
          "PgDn": { "label": "PgDn", "custom": 2, "width": 1.5, "role": "KeyRole.Special", "repeat": true },
          "Ins": { "label": "Ins", "custom": 3, "width": 1.5, "role": "KeyRole.Special" },
          "Del": { "label": "Del", "action": "TextInput.Delete", "width": 1.5, "role": "KeyRole.Special", "repeat": true },
          "Close": { "icon": "close", "custom": 1, "role": "KeyRole.Special" },
          "OK": { "icon": "check", "action": "TextInput.Enter", "role": "KeyRole.Primary" },
          "^a": { "label": "a", "insert": "\u0001" },
          "^b": { "label": "b", "insert": "\u0002" },
          "^c": { "label": "c", "insert": "\u0003" },
          "^d": { "label": "d", "insert": "\u0004" },
          "^e": { "label": "e", "insert": "\u0005" },
          "^f": { "label": "f", "insert": "\u0006" },
          "^g": { "label": "g", "insert": "\u0007" },
          "^h": { "label": "h", "insert": "\b" },
          "^i": { "label": "i", "insert": "\t" },
          "^j": { "label": "j", "insert": "\n" },
          "^k": { "label": "k", "insert": "\u000b" },
          "^l": { "label": "l", "insert": "\f" },
          "^m": { "label": "m", "insert": "\r" },
          "^n": { "label": "n", "insert": "\u000e" },
          "^o": { "label": "o", "insert": "\u000f" },
          "^p": { "label": "p", "insert": "\u0010" },
          "^q": { "label": "q", "insert": "\u0011" },
          "^r": { "label": "r", "insert": "\u0012" },
          "^s": { "label": "s", "insert": "\u0013" },
          "^t": { "label": "t", "insert": "\u0014" },
          "^u": { "label": "u", "insert": "\u0015" },
          "^v": { "label": "v", "insert": "\u0016" },
          "^w": { "label": "w", "insert": "\u0017" },
          "^x": { "label": "x", "insert": "\u0018" },
          "^y": { "label": "y", "insert": "\u0019" },
          "^z": { "label": "z", "insert": "\u001a" }
        },
        "terminal_portrait": {
          "height": 440,
          "layers": [
            {
              "id": "base",
              "columns": 12,
              "layout": [
                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
                ["Ctrl", "a", "s", "d", "f", "g", "h", "j", "k", "l", "Enter"],
                ["Shift", "z", "x", "c", "v", "b", "n", "m", ",", ".", "'"],
                ["?#&", "-", "/", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "shift",
              "columns": 12,
              "layout": [
                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
                ["Ctrl", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Enter"],
                ["Shift*", "Z", "X", "C", "V", "B", "N", "M", "<", ">", "\""],
                ["?#&", "_", "?", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "caps",
              "columns": 12,
              "layout": [
                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
                ["Ctrl", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Enter"],
                ["ShiftLock", "Z", "X", "C", "V", "B", "N", "M", "<", ">", "\""],
                ["?#&", "_", "?", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "ctrl",
              "columns": 12,
              "layout": [
                ["Esc", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "BS"],
                ["Tab", "^q", "^w", "^e", "^r", "^t", "^y", "^u", "^i", "^o", "^p"],
                ["Ctrl*", "^a", "^s", "^d", "^f", "^g", "^h", "^j", "^k", "^l", "Enter"],
                ["Shift", "^z", "^x", "^c", "^v", "^b", "^n", "^m", ",", ".", "'"],
                ["?#&", "-", "/", "Space", "Left", "Up", "Down", "Right"]
              ]
            },
            {
              "id": "sym",
              "columns": 12,
              "layout": [
                ["Esc", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "BS"],
                ["Tab", "~", "`", "|", "\\", "{", "}", "[", "]", "<", ">"],
                ["Ctrl", ";", ":", "\"", "=", "+", "_", "?", "Enter3.5"],
                ["Shift", "Home", "End", "PgUp", "PgDn", "Ins", "Del"],
                ["?#&*", "-", "/", "Space", "Left", "Up", "Down", "Right"]
              ]
            }
          ]
        },
        "terminal_landscape": {
